# Copy to .env. npm run demo, test:live and provider:check load it automatically.
# Shell environment variables take precedence. Never commit an API key.
RIBOSOME_PROVIDER=azure-openai-responses
# The underlying Pi model ID, not your Azure deployment name.
RIBOSOME_MODEL=your-model-id
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com
# Pi's Azure provider uses Responses, with the v1 API by default.
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_DEPLOYMENT_NAME_MAP=your-model-id=your-deployment
# Alternatively, omit BASE_URL and set AZURE_OPENAI_RESOURCE_NAME.
# Omit DEPLOYMENT_NAME_MAP if the deployment name already matches the model ID.
